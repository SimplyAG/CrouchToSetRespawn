{
	"schemaVersion": 1,
	"id": "crouchtosetrespawn",
	"version": "${version}",
	"name": "Crouch to Set Respawn",
	"description": "Sleeping no longer moves your spawn. Sneak + use a bed to set your respawn point there, day or night. Server-side only: players don't need to install it.",
	"authors": [
		"SimplyAG"
	],
	"contact": {
		"homepage": "https://github.com/SimplyAG/CrouchToSetRespawn",
		"sources": "https://github.com/SimplyAG/CrouchToSetRespawn",
		"issues": "https://github.com/SimplyAG/CrouchToSetRespawn/issues"
	},
	"license": "MIT",
	"icon": "assets/crouchtosetrespawn/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.simplyag.crouchtosetrespawn.CrouchToSetRespawn"
		]
	},
	"mixins": [
		"crouchtosetrespawn.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_floor}",
		"minecraft": ["${minecraft_dep}"],
		"java": ">=${java_version}",
		"fabric-resource-loader-v0": "*"
	}
}
